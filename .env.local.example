# Local development only
DATABASE_URL="postgresql://root@localhost:26257/nexora?sslmode=disable"

NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="nexora-local-development-secret-change-before-production"
NEXT_PUBLIC_LOCAL_DEMO_MODE="true"

# Optional locally. If empty, register shows a development verification code.
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
EMAIL_SERVER=""
EMAIL_FROM=""

# Optional push notifications
NEXT_PUBLIC_VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
VAPID_SUBJECT="mailto:local@nexora.dev"
NOTIFICATIONS_CRON_SECRET="nexora-local-cron-secret"
CRON_SECRET="nexora-local-cron-secret"
