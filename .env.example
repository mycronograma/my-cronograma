# Database (CockroachDB)
# Formato: postgresql://user:password@host:26257/database?sslmode=require
# O schema Prisma usa provider = "cockroachdb".
DATABASE_URL="postgresql://user:password@host:26257/nexora?sslmode=require"

# NextAuth
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="replace_with_strong_secret"
GOOGLE_CLIENT_ID="replace_with_google_client_id"
GOOGLE_CLIENT_SECRET="replace_with_google_client_secret"
# SMTP example: smtp://user:pass@smtp.mailserver.com:587
EMAIL_SERVER="smtp://user:pass@smtp.mailserver.com:587"
EMAIL_FROM="Nexora <no-reply@nexora.com>"

# Web Push (VAPID)
NEXT_PUBLIC_VAPID_PUBLIC_KEY="replace_with_vapid_public_key"
VAPID_PRIVATE_KEY="replace_with_vapid_private_key"
VAPID_SUBJECT="mailto:seuemail@dominio.com"

# Notifications dispatch auth
NOTIFICATIONS_CRON_SECRET="replace_with_strong_secret"
CRON_SECRET="replace_with_same_notifications_cron_secret"

# Optional: Analytics
# NEXT_PUBLIC_ANALYTICS_ID=""
